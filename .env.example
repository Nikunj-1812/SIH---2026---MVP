# ==========================================
# APP & ENVIRONMENT
# ==========================================

APP_NAME="SIH 2026 AI Content Transformation Platform"
ENVIRONMENT="development"
API_HOST="0.0.0.0"
API_PORT="8000"
LOG_LEVEL="INFO"
DEBUG="true"

# ==========================================
# DEPLOYED FRONTEND URL
# ==========================================

FRONTEND_URL="https://sih-2026-mvp.vercel.app"
NEXT_PUBLIC_FRONTEND_URL="https://sih-2026-mvp.vercel.app"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ==========================================
# SUPABASE
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ==========================================
# TEXT AI (GROQ / QWEN)
# ==========================================

TEXT_LLM_PROVIDER="groq"
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_BASE_URL="https://api.groq.com/openai/v1"
TEXT_LLM_MODEL="qwen/qwen3.6-27b"

# ==========================================
# IMAGE GENERATION (POLLINATIONS)
# ==========================================

IMAGE_PROVIDER="pollinations"
POLLINATIONS_API_KEY=sk_your_pollinations_key_here
POLLINATIONS_IMAGE_MODEL=qwen-image
POLLINATIONS_BASE_URL="https://gen.pollinations.ai"

# ==========================================
# SECURITY & INTEGRITY
# ==========================================

ENABLE_FILE_VALIDATION="true"
ENABLE_PII_DETECTION="true"
ENABLE_PROMPT_INJECTION_CHECK="true"
ENABLE_INTEGRITY_HASH="true"
HASH_ALGORITHM="SHA256"
JWT_SECRET=your_jwt_secret_here
